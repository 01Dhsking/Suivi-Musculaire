# Dokploy : renseigner ces deux secrets dans l'onglet Environment.
# Local : copier ce fichier dans .env et remplacer ces deux valeurs.
POSTGRES_PASSWORD=remplacer-par-un-secret-postgres
APP_PASSWORD=remplacer-par-un-secret-application
# Uniquement pour docker-compose.local.yml ; pas de port hôte dans Dokploy.
APP_PORT=3000
# 127.0.0.1 : cet ordinateur. 0.0.0.0 : accès depuis le réseau local.
APP_BIND=127.0.0.1
# Développement hors Docker : URL d'une base PostgreSQL accessible.
# DATABASE_URL=postgresql://suivi:mot-de-passe@localhost:5432/suivi_musculaire
